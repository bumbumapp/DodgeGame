<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F16">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/hw_banner_view">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- HUD: level, time, score, lives as small Bento chips. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0D0F16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/levelText"
                    style="@style/DG.Hud"
                    android:text="@string/level_initial" />

                <TextView
                    android:id="@+id/timeText"
                    style="@style/DG.Hud"
                    android:text="@string/time" />

                <TextView
                    android:id="@+id/score"
                    style="@style/DG.Hud"
                    android:layout_weight="1.3"
                    android:text="@string/score"
                    android:textColor="#FFC857" />

                <TextView
                    android:id="@+id/livesText"
                    style="@style/DG.Hud"
                    android:text="@string/lives_initial" />

                <ImageButton
                    android:id="@+id/ic_more"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/dg_chip"
                    android:contentDescription="@string/more_options"
                    android:src="@drawable/ic_more" />
            </LinearLayout>

            <com.dozingcatsoftware.dodge.FieldView
                android:id="@+id/fieldView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Pause card -->
        <LinearLayout
            android:id="@+id/pausedMenuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/dg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:letterSpacing="-0.02"
                    android:text="@string/game_paused"
                    android:textColor="#EDEFF5"
                    android:textSize="26sp" />

                <Button
                    android:id="@+id/continueGameButton"
                    style="@style/DG.Button.Primary"
                    android:layout_marginTop="18dp"
                    android:text="@string/continue_game" />

                <Button
                    android:id="@+id/endGameButton"
                    style="@style/DG.Button"
                    android:text="@string/end_game" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main menu card -->
        <LinearLayout
            android:id="@+id/menuView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/dg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_extrabold"
                    android:letterSpacing="-0.03"
                    android:text="@string/menu_title"
                    android:textColor="#EDEFF5"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jakarta_medium"
                    android:text="@string/welcome_message"
                    android:textColor="#9AA1B2"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/newGameButton"
                    style="@style/DG.Button.Primary"
                    android:layout_marginTop="18dp"
                    android:text="@string/new_game" />

                <Button
                    android:id="@+id/freePlayButton"
                    style="@style/DG.Button"
                    android:text="@string/free_play" />

                <Button
                    android:id="@+id/continueFreePlayButton"
                    style="@style/DG.Button"
                    android:text="@string/continue_free_play" />

                <Button
                    android:id="@+id/preferencesButton"
                    style="@style/DG.Button"
                    android:text="@string/settings" />

                <!-- Best results -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:stretchColumns="1,3">

                    <TableRow android:id="@+id/bestLevelView">

                        <TextView style="@style/DG.Stat" android:text="@string/best_level" />

                        <TextView
                            android:id="@+id/bestLevelText"
                            style="@style/DG.StatValue"
                            android:paddingStart="6dp" />

                        <TextView style="@style/DG.Stat" android:text="@string/highscore_label" />

                        <TextView
                            android:id="@+id/bestScoreText"
                            style="@style/DG.StatValue"
                            android:paddingStart="6dp" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/bestFreePlayLevelView"
                        android:layout_marginTop="6dp">

                        <TextView style="@style/DG.Stat" android:text="@string/best_free_play_level" />

                        <TextView
                            android:id="@+id/bestFreePlayLevelText"
                            style="@style/DG.StatValue"
                            android:paddingStart="6dp" />

                        <TextView style="@style/DG.Stat" android:text="@string/highscore_label" />

                        <TextView
                            android:id="@+id/highscore"
                            style="@style/DG.StatValue"
                            android:paddingStart="6dp" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/hw_banner_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true" />
</RelativeLayout>
