<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bento (dark) game UI: Plus Jakarta Sans, 28dp card, 16dp buttons. -->
    <style name="DG.Button" parent="android:Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/dg_button_tonal</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dg_button_text</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="DG.Button.Primary">
        <item name="android:background">@drawable/dg_button_primary</item>
        <item name="android:textColor">#1A1200</item>
    </style>
    <style name="DG.Hud" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/dg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#EDEFF5</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="DG.Stat" parent="">
        <item name="android:fontFamily">@font/jakarta_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#9AA1B2</item>
    </style>
    <style name="DG.StatValue" parent="DG.Stat">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:textColor">#EDEFF5</item>
    </style>
</resources>
